# Port the HTTP + Socket.IO server listens on.
PORT=8787
# Secret used to sign guest session tokens. Required in production (32+ random chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma separated list of allowed browser origins. Use * only for local development.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
# Optional PostgreSQL connection string for match history. Leave empty to keep history in memory.
DATABASE_URL=
# Optional directory with the built web client to serve from this process.
STATIC_DIR=../client/dist
# Default match length in seconds (60-600).
MATCH_DURATION_SEC=180
# Seconds a disconnected player has to come back before forfeiting a running match.
RECONNECT_WINDOW_SEC=30
# Quick Play: fill window once two players are waiting, and the total search timeout.
QUICKPLAY_FILL_SEC=8
QUICKPLAY_TIMEOUT_SEC=45
# Trust X-Forwarded-For from a reverse proxy (true behind Fly/Render/NGINX).
TRUST_PROXY=false
