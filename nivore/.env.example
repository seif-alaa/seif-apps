# ── NIVORÉ environment ──────────────────────────────────────────────
# Copy to .env.local for local development. Never commit real values.

# Admin sign-in (development store). In production this is replaced by a
# real identity provider (see docs/PRODUCTION.md). Required in production.
ADMIN_EMAIL=atelier@example.com
ADMIN_PASSWORD=change-me-locally

# 32+ random characters used to sign session and access cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public site URL, used for share links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persistence driver. "dev" = local JSON file in .data/ (development only).
# "supabase" is reserved for the production integration (not yet implemented).
DATA_DRIVER=dev

# ── Reserved for Phase 6 (do not fill until integrations are built) ──
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never NEXT_PUBLIC_
# RESEND_API_KEY=
